# {{ ansible_managed }}
# Written by ansible/roles/campussport (docker-compose.yml reads it). Do not edit on the server.
{% set demo = campussport_mode == 'demo' %}
{% set profiles = [] %}
{% if campussport_keycloak_enabled | bool %}{% set _ = profiles.append('sso') %}{% endif %}
{% if campussport_mailpit_enabled | bool %}{% set _ = profiles.append('mail') %}{% endif %}
# Mode: {{ campussport_mode }}
NODE_ENV={{ 'development' if demo else 'production' }}
DEV_LOGIN={{ campussport_dev_login | bool | lower }}
SEED_EXAMPLE_DATA={{ campussport_seed_example_data | bool | lower }}
KEYCLOAK_REALM={{ 'demo' if demo else 'production' }}
COMPOSE_PROFILES={{ profiles | join(',') }}

PUBLIC_SCHEME=https
DOMAIN={{ campussport_domain }}
AUTH_DOMAIN={{ campussport_auth_domain }}
ACME_EMAIL={{ campussport_acme_email }}
COOKIE_SECURE=true
OIDC_ALLOW_INSECURE=false

POSTGRES_PASSWORD={{ campussport_postgres_password }}
KEYCLOAK_DB_PASSWORD={{ campussport_keycloak_db_password }}
KEYCLOAK_ADMIN_PASSWORD={{ campussport_keycloak_admin_password }}
JWT_ACCESS_SECRET={{ campussport_jwt_access_secret }}
QR_HMAC_SECRET={{ campussport_qr_hmac_secret }}
OIDC_CLIENT_SECRET={{ campussport_oidc_client_secret }}
DEMO_USER_PASSWORD={{ campussport_demo_user_password }}

SMTP_HOST={{ campussport_smtp_host }}
SMTP_PORT={{ campussport_smtp_port }}
SMTP_FROM={{ campussport_smtp_from }}
VAPID_PUBLIC_KEY={{ campussport_vapid_public_key }}
VAPID_PRIVATE_KEY={{ campussport_vapid_private_key }}
VAPID_SUBJECT=mailto:{{ campussport_acme_email }}

FACILITY_TIMEZONE={{ campussport_facility_timezone }}
LOG_LEVEL={{ campussport_log_level }}
TOTP_ISSUER=CampusSport
IMAGE_TAG={{ campussport_repo_version | regex_replace('[^A-Za-z0-9_.-]', '-') }}
