# Configuration of the container stack (docker-compose.yml). Copy to `.env` in the repo root.
# The values below run a DEMO locally on http://localhost (Keycloak on http://auth.localhost).
# On a VPS, ansible/ writes this file for you (see ansible/README.md).

# ── Mode ────────────────────────────────────────────────────────────────────────────────────────
# demo:        NODE_ENV=development, DEV_LOGIN=true,  SEED_EXAMPLE_DATA=true,  KEYCLOAK_REALM=demo
# production:  NODE_ENV=production,  DEV_LOGIN=false, SEED_EXAMPLE_DATA=false, KEYCLOAK_REALM=production
NODE_ENV=development
DEV_LOGIN=true
SEED_EXAMPLE_DATA=true
KEYCLOAK_REALM=demo
# Optional services: sso = Keycloak, mail = Mailpit (UI on 127.0.0.1:8025). Comma separated.
COMPOSE_PROFILES=sso,mail

# ── Addresses ───────────────────────────────────────────────────────────────────────────────────
# VPS: PUBLIC_SCHEME=https, DOMAIN=campussport.example.com, AUTH_DOMAIN=auth.campussport.example.com,
# both DNS A records pointing at the VPS, COOKIE_SECURE=true, OIDC_ALLOW_INSECURE=false.
PUBLIC_SCHEME=http
DOMAIN=localhost
AUTH_DOMAIN=auth.localhost
# Let's Encrypt account e-mail (only used with https).
ACME_EMAIL=admin@localhost
COOKIE_SECURE=false
OIDC_ALLOW_INSECURE=true

# ── Secrets (generate real ones: openssl rand -base64 48) ───────────────────────────────────────
POSTGRES_PASSWORD=change-me-postgres
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
JWT_ACCESS_SECRET=change-me-jwt-access-secret-at-least-32-chars
QR_HMAC_SECRET=change-me-qr-hmac-secret-at-least-32-chars
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
# Password of the Keycloak test users student1 / teacher1 / admin1 (demo realm only).
DEMO_USER_PASSWORD=parola123

# ── Mail and push (production: a real SMTP relay) ───────────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=CampusSport <no-reply@campussport.example>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@campussport.example

FACILITY_TIMEZONE=Europe/Chisinau
LOG_LEVEL=info
TOTP_ISSUER=CampusSport
IMAGE_TAG=local
