{
  "name": "campussport-backend",
  "version": "0.1.0",
  "description": "CampusSport API and worker (NestJS modular monolith)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.1",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.3",
    "@prometheus-io/client": "^0.16.1",
    "bullmq": "^6.7.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "luxon": "^3.7.2",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.5.0",
    "openid-client": "^6.8.9",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
