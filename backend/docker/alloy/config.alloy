// Ships the JSON logs of the api and worker containers to Loki (SYS-09).
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "campussport" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "api|worker"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "campussport" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.campussport.output
  forward_to = [loki.process.json.receiver]
}

loki.process "json" {
  stage.json {
    expressions = { level = "level", msg = "msg" }
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
