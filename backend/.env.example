# Copy to .env for local development. Values below match docker-compose.yml.
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
PWA_URL=http://localhost:5173
FACILITY_TIMEZONE=Europe/Chisinau

DATABASE_URL=postgres://campussport:campussport@localhost:5432/campussport
REDIS_URL=redis://localhost:6379

# Secrets: generate real ones outside development (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_MEMBER_DAYS=30
REFRESH_TTL_ADMIN_HOURS=8
QR_HMAC_SECRET=dev-only-qr-secret-change-me
COOKIE_SECURE=false

# OpenID Connect (local Keycloak from docker-compose; realm in docker/keycloak/)
OIDC_ISSUER=http://localhost:8080/realms/campussport
OIDC_CLIENT_ID=campussport-api
OIDC_CLIENT_SECRET=campussport-dev-secret
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/sso/callback
OIDC_SCOPE=openid email profile
OIDC_ROLE_CLAIM=campussport_roles
# JSON map from IdP claim values to CampusSport roles
OIDC_ROLE_MAP={"student":"student","teacher":"teacher","faculty":"teacher","admin":"admin"}
OIDC_ALLOW_INSECURE=true
TOTP_ISSUER=CampusSport

# Email (Mailpit UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=CampusSport <no-reply@campussport.example>

# Web Push (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@campussport.example
