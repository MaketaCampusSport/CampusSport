# Mod de dezvoltare implicit (npm run dev): front-end-ul vorbește cu serverul NestJS real
# prin proxy-ul Vite (/api -> VITE_API_PROXY_TARGET). Pornește ambele din rădăcină cu `npm run dev`.
# Pentru serverul simulat (MSW), fără backend: `npm run dev:mock`.
VITE_USE_MOCKS=false
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:3000
