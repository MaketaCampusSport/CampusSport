# Copiază în `.env.local` pentru a rula împotriva serverului real (NestJS).
VITE_USE_MOCKS=false
# Prefixul API (SDD cap. 6: /api/v1). Relativ => trece prin proxy-ul Vite în dezvoltare.
VITE_API_BASE_URL=/api/v1
# Unde ascultă serverul NestJS în dezvoltare (folosit doar de proxy-ul Vite).
VITE_API_PROXY_TARGET=http://localhost:3000
# Doar în dezvoltare, fără SSO real: un JWT de test (ignorat în build-ul de producție).
# VITE_DEV_TOKEN=