{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Segoe UI, Helvetica, Arial, sans-serif",
    "fontSize": "15px",
    "primaryColor": "#E8F1FB",
    "primaryBorderColor": "#2F6DB5",
    "primaryTextColor": "#1B2733",
    "secondaryColor": "#EAF6EE",
    "secondaryBorderColor": "#2E8B57",
    "tertiaryColor": "#FFF6E5",
    "tertiaryBorderColor": "#C27C0E",
    "lineColor": "#5B6B7B",
    "textColor": "#1B2733",
    "noteBkgColor": "#FFF9DB",
    "noteBorderColor": "#C9A227",
    "actorBkg": "#E8F1FB",
    "actorBorder": "#2F6DB5",
    "signalColor": "#3B4A59",
    "labelBoxBkgColor": "#E8F1FB",
    "edgeLabelBackground": "#FFFFFF"
  },
  "flowchart": { "curve": "basis", "htmlLabels": true, "padding": 14, "wrappingWidth": 340 },
  "er": { "layoutDirection": "LR", "minEntityWidth": 120 },
  "sequence": { "mirrorActors": false, "showSequenceNumbers": true },
  "gantt": { "barHeight": 26, "fontSize": 13, "sectionFontSize": 14 }
}
